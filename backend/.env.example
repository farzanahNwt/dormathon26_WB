# ------------------------------------------------------------------------------
# 1. TENCENT CLOUD API CREDENTIALS (Required for WorkBuddy SDK & Agent Runtime)
# ------------------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=your_tencent_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_tencent_secret_key_here
TENCENTCLOUD_REGION=ap-guangzhou

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Required for Multimodal Vision & Scam Reasoning)
# ------------------------------------------------------------------------------
# Model: gemini-3-flash-preview (with fallback to gemini-flash-latest)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. SIGHTENGINE API (Forensic Image AI & Synthetic Artifact Verification)
# ------------------------------------------------------------------------------
SIGHTENGINE_API_USER=your_sightengine_user_id
SIGHTENGINE_API_SECRET=your_sightengine_secret_here
SIGHTENGINE_API_SECRET_ALT=your_sightengine_alt_secret_here

# ------------------------------------------------------------------------------
# 4. SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
DEBUG=False
