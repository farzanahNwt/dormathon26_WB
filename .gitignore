# ==============================================================================
# Git Ignore - LAICIs Autonomous Investigation Agent
# ==============================================================================

# Environment & Secrets (Never commit live credentials)
.env
.env.local
.env.*.local

# Python Caches & Compilations
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Runtime Uploads & Generated Media (Keep directory with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# SQLite Databases & Ephemeral Storage
*.sqlite3
*.db-journal

# IDE & OS Metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# Large Archives & Packages
*.zip
*.tar.gz
*.rar
*.7z
