{
  "manifest_version": 3,
  "name": "LAICIs — AI Media & Fraud Verification Agent",
  "version": "2.0.0",
  "description": "Real-time deepfake forensics, phishing detection, and scam intelligence powered by Tencent WorkBuddy & Google Gemini.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LAICIs Quick Verification Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*",
    "http://*/*"
  ]
}
